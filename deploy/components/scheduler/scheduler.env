# Scheduler settings (SCHEDULER_* variables, see README). Blank = default.
# Executor and namespace default to kubernetes / the pod's own namespace.
SCHEDULER_MLFLOW_TRACKING_URI=http://mlflow.mlflow.svc:5000
SCHEDULER_CONTAINER_MLFLOW_TRACKING_URI=
SCHEDULER_MLFLOW_UI_URI=
# agent image: must come from a registry the cluster can pull from
SCHEDULER_DEFAULT_IMAGE=registry.example.com/docling-agent:latest
SCHEDULER_IMAGE_ALLOWLIST=registry.example.com/docling-agent
SCHEDULER_K8S_IMAGE_PULL_SECRET=
SCHEDULER_K8S_ACTIVE_DEADLINE=
SCHEDULER_MAX_SHARDS=
SCHEDULER_CONCURRENCY_WARNING=
SCHEDULER_RECONCILE_INTERVAL=
# Host headers and browser origins the API accepts: the Route/Ingress hostname
# (keep localhost for port-forwards and probes)
SCHEDULER_ALLOWED_HOSTS=docling-scheduler.apps.example.com,localhost,127.0.0.1
SCHEDULER_ALLOWED_ORIGINS=https://docling-scheduler.apps.example.com
LOG_LEVEL=INFO
